@{
    ViewData["Title"] = "Greetings";

    const int EveningStartHour = 12;

    var myMessage = "Hello C# Marathon!";
    var greeting = "Welcome to our project!";
    var now = DateTime.Now;

    string wish;
    if (now.Hour < EveningStartHour)
    {
        wish = "Good Morning!";
    }
    else
    {
        wish = "Good Evening!";
    }
}

<h1>Greetings</h1>
<p>The value of myMessage is: @myMessage</p>
<p>The greeting is: @greeting</p>
<p>Here in Ukraine: @now.DayOfWeek</p>
<p>We wish you: @wish</p>
<p>Today is @DateTime.Today.DayOfWeek</p>

<table class="bordered-table">
    <tr>
        <th>Name</th>
        <th>Value</th>
    </tr>
    <tr>
        <td>Day</td>
        <td>@now.Day</td>
    </tr>
    <tr>
        <td>Hour</td>
        <td>@now.Hour</td>
    </tr>
    <tr>
        <td>Minute</td>
        <td>@now.Minute</td>
    </tr>
    <tr>
        <td>Second</td>
        <td>@now.Second</td>
    </tr>
</table>
